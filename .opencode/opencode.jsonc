{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "intellij": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/sse",
      "enabled": true
    },
    "nuxtUI": {
      "type": "remote",
      "url": "https://ui.nuxt.com/mcp",
      "enabled": true
    },
//    "stitch": {
//      "type": "remote",
//      "url": "https://stitch.googleapis.com/mcp",
//      "enabled": true,
//      "headers": {
//      }
//    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "ag-grid": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "ag-mcp"
      ],
      "enabled": true
    }
  }
}
